<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.ModifyFingerprintsController">
    <TableView fx:id="fingerprintTable" layoutX="14.0" layoutY="14.0" prefHeight="200.0" prefWidth="600.0">
        <columns>
            <TableColumn fx:id="activityColumn" text="Activity" />
            <TableColumn fx:id="valueColumn" text="Value" />
            <TableColumn fx:id="unitColumn" text="Unit" />
            <TableColumn fx:id="dateColumn" text="Date" />
        </columns>
    </TableView>
    <Button layoutX="14.0" layoutY="230.0" mnemonicParsing="false" onAction="#deleteFingerprint" text="Delete Fingerprint" />
    <Button layoutX="150.0" layoutY="230.0" mnemonicParsing="false" onAction="#modifyFingerprint" text="Modify Fingerprint" />
    <Button layoutX="300.0" layoutY="230.0" mnemonicParsing="false" onAction="#goToMainMenu" text="Main Menu" />
</AnchorPane>