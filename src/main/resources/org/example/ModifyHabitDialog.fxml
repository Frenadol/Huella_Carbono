<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="220.0" prefWidth="367.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ModifyHabitDialogController" style="-fx-background-color: #98FB98;" stylesheets="CSS/ModifyHabitDialog.css">
    <Label layoutX="14.0" layoutY="54.0" text="Frecuencia" />
    <ComboBox fx:id="frequencyField" layoutX="150.0" layoutY="50.0" />

    <Label layoutX="14.0" layoutY="94.0" text="Tipo" />
    <ComboBox fx:id="typeField" layoutX="150.0" layoutY="90.0" />

    <Label layoutX="14.0" layoutY="134.0" text="Fecha:" />
    <DatePicker fx:id="startDatePicker" layoutX="150.0" layoutY="130.0" />

    <Button layoutX="42.0" layoutY="167.0" onAction="#saveHabit" text="Guardar cambios" />
    <Button layoutX="245.0" layoutY="167.0" mnemonicParsing="false" onAction="#backToModifyHabits" text="Volver atras" />
</AnchorPane>