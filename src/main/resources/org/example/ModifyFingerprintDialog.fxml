<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="210.0" prefWidth="313.0" style="-fx-background-color: #98FB98;" stylesheets="@CSS/ModifyFingerprintDialog.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ModifyFingerprintsDialogController">
    <children>
        <Label layoutX="33.0" layoutY="21.0" text="Actividad:" />
        <ComboBox fx:id="activityComboBox" layoutX="100.0" layoutY="10.0" prefWidth="200.0" />

        <Label layoutX="57.0" layoutY="64.0" text="Valor:" />
        <TextField fx:id="valueField" layoutX="100.0" layoutY="58.0" prefWidth="200.0" />

        <Label layoutX="55.0" layoutY="113.0" text="Fecha:" />
        <DatePicker fx:id="datePicker" layoutX="100.0" layoutY="100.0" prefWidth="200.0" />

        <Button layoutX="8.0" layoutY="160.0" mnemonicParsing="false" onAction="#saveChanges" text="Guardar" />
        <Button layoutX="206.0" layoutY="160.0" mnemonicParsing="false" onAction="#closeDialog" text="Cancelar" />
      <Button layoutX="108.0" layoutY="160.0" mnemonicParsing="false" onMouseClicked="#deleteFingerPrint" prefHeight="41.0" prefWidth="90.0" text="Borrar" />
    </children>
</AnchorPane>
